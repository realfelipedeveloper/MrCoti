            "type": "string",
            "format": "uuid"
          },
          "code": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "AVAILABLE",
              "OCCUPIED",
              "BLOCKED"
            ]
          }
        }
      },
      "CreateTableRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
