{
  "openapi": "3.1.0",
  "info": {
    "title": "Mr Coti MVP Local API",
    "version": "0.1.0-draft",
    "description": "Contrato da primeira fatia local implementável do Mr Coti. Usa dados sintéticos e pagamento fake; não representa produção comercial."
  },
  "servers": [
    {
      "url": "http://localhost:3200/api/v1",
      "description": "API local futura do Mr Coti"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/auth/login": {
      "post": {
        "operationId": "loginLocalUser",
        "summary": "Autentica usuário sintético local",
        "security": [],
        "parameters": [
          {
            "$ref": "#/components/parameters/XRequestId"
          },
          {
            "$ref": "#/components/parameters/XCorrelationId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              },
              "examples": {
                "waiter": {
                  "value": {
                    "email": "waiter.demo@mrcoti.local",
                    "password": "demo-password"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login aceito",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/XRequestId"
              },
              "X-Correlation-Id": {
                "$ref": "#/components/headers/XCorrelationId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "logoutLocalUser",
        "summary": "Encerra sessão local",
        "parameters": [
          {
            "$ref": "#/components/parameters/XRequestId"
          },
          {
            "$ref": "#/components/parameters/XCorrelationId"
          }
        ],
        "responses": {
          "204": {
            "description": "Sessão encerrada"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/me": {
      "get": {
        "operationId": "getCurrentUserContext",
        "summary": "Obtém usuário, tenant, unidade e permissões correntes",
        "parameters": [
          {
            "$ref": "#/components/parameters/XRequestId"
          },
          {
            "$ref": "#/components/parameters/XCorrelationId"
          }
        ],
        "responses": {
          "200": {
            "description": "Contexto autenticado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentContext"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/units": {
      "get": {
        "operationId": "listAccessibleUnits",
        "summary": "Lista unidades acessíveis no tenant corrente",
        "parameters": [
          {
            "$ref": "#/components/parameters/XRequestId"
          },
          {
            "$ref": "#/components/parameters/XCorrelationId"
          }
        ],
        "responses": {
          "200": {
            "description": "Unidades acessíveis",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Unit"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/catalog/categories": {
      "get": {
        "operationId": "listCategories",
        "summary": "Lista categorias da unidade",
        "parameters": [
          {
            "$ref": "#/components/parameters/XUnitId"
          },
          {
            "$ref": "#/components/parameters/XRequestId"
          },
          {
            "$ref": "#/components/parameters/XCorrelationId"
          }
        ],
        "responses": {
          "200": {
            "description": "Categorias",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Category"
                  }
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      },
      "post": {
        "operationId": "createCategory",
        "summary": "Cria categoria",
        "parameters": [
          {
            "$ref": "#/components/parameters/XUnitId"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          },
          {
            "$ref": "#/components/parameters/XRequestId"
          },
          {
            "$ref": "#/components/parameters/XCorrelationId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCategoryRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Categoria criada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Category"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "409": {
            "$ref": "#/components/responses/IdempotencyConflict"
          }
        }
      }
    },
    "/catalog/products": {
      "get": {
        "operationId": "listProducts",
        "summary": "Lista produtos da unidade",
        "parameters": [
          {
            "$ref": "#/components/parameters/XUnitId"
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/ProductStatus"
            }
          },
          {
            "$ref": "#/components/parameters/XRequestId"
          },
          {
            "$ref": "#/components/parameters/XCorrelationId"
          }
        ],
        "responses": {
          "200": {
            "description": "Produtos",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Product"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createProduct",
        "summary": "Cria produto",
        "parameters": [
          {
            "$ref": "#/components/parameters/XUnitId"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          },
          {
            "$ref": "#/components/parameters/XRequestId"
          },
          {
            "$ref": "#/components/parameters/XCorrelationId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateProductRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Produto criado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Product"
                }
              }
            }
          },
          "409": {
            "$ref": "#/components/responses/IdempotencyConflict"
          }
        }
      }
    },
    "/tables": {
      "get": {
        "operationId": "listTables",
        "summary": "Lista mesas da unidade",
        "parameters": [
          {
            "$ref": "#/components/parameters/XUnitId"
          },
          {
            "$ref": "#/components/parameters/XRequestId"
          },
          {
            "$ref": "#/components/parameters/XCorrelationId"
          }
        ],
        "responses": {
          "200": {
            "description": "Mesas",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/RestaurantTable"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createTable",
        "summary": "Cria mesa",
        "parameters": [
          {
            "$ref": "#/components/parameters/XUnitId"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          },
          {
            "$ref": "#/components/parameters/XRequestId"
          },
          {
            "$ref": "#/components/parameters/XCorrelationId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTableRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Mesa criada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RestaurantTable"
                }
              }
            }
          }
        }
      }
    },
    "/tabs": {
      "post": {
        "operationId": "openTab",
        "summary": "Abre comanda para uma mesa",
        "parameters": [
          {
            "$ref": "#/components/parameters/XUnitId"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          },
          {
            "$ref": "#/components/parameters/XRequestId"
          },
          {
            "$ref": "#/components/parameters/XCorrelationId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OpenTabRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Comanda aberta",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Tab"
                }
              }
            }
          },
          "409": {
            "$ref": "#/components/responses/IdempotencyConflict"
          }
        }
      }
    },
    "/tabs/{tabId}": {
      "get": {
        "operationId": "getTab",
        "summary": "Consulta comanda",
        "parameters": [
          {
            "$ref": "#/components/parameters/TabId"
          },
          {
            "$ref": "#/components/parameters/XUnitId"
          },
          {
            "$ref": "#/components/parameters/XRequestId"
          },
          {
            "$ref": "#/components/parameters/XCorrelationId"
          }
        ],
        "responses": {
          "200": {
            "description": "Comanda",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Tab"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/tabs/{tabId}/items": {
      "post": {
        "operationId": "addTabItem",
        "summary": "Adiciona item à comanda",
        "parameters": [
          {
            "$ref": "#/components/parameters/TabId"
          },
          {
            "$ref": "#/components/parameters/XUnitId"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          },
          {
            "$ref": "#/components/parameters/XRequestId"
          },
          {
            "$ref": "#/components/parameters/XCorrelationId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddItemRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Item adicionado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderItem"
                }
              }
            }
          },
          "409": {
            "$ref": "#/components/responses/IdempotencyConflict"
          }
        }
      }
    },
    "/tabs/{tabId}/items/{itemId}": {
      "patch": {
        "operationId": "updateTabItemQuantity",
        "summary": "Altera quantidade do item",
        "parameters": [
          {
            "$ref": "#/components/parameters/TabId"
          },
          {
            "$ref": "#/components/parameters/ItemId"
          },
          {
            "$ref": "#/components/parameters/XUnitId"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          },
          {
            "$ref": "#/components/parameters/XRequestId"
          },
          {
            "$ref": "#/components/parameters/XCorrelationId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateItemQuantityRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Item atualizado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderItem"
                }
              }
            }
          },
          "409": {
            "$ref": "#/components/responses/IdempotencyConflict"
          }
        }
      }
    },
    "/tabs/{tabId}/items/{itemId}/cancel": {
      "post": {
        "operationId": "cancelTabItem",
        "summary": "Cancela item da comanda",
        "parameters": [
          {
            "$ref": "#/components/parameters/TabId"
          },
          {
            "$ref": "#/components/parameters/ItemId"
          },
          {
            "$ref": "#/components/parameters/XUnitId"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          },
          {
            "$ref": "#/components/parameters/XRequestId"
          },
          {
            "$ref": "#/components/parameters/XCorrelationId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CancelItemRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Item cancelado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderItem"
                }
              }
            }
          }
        }
      }
    },
    "/tabs/{tabId}/close": {
      "post": {
        "operationId": "closeTabWithFakePayment",
        "summary": "Fecha a conta com pagamento fake",
        "parameters": [
          {
            "$ref": "#/components/parameters/TabId"
          },
          {
            "$ref": "#/components/parameters/XUnitId"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          },
          {
            "$ref": "#/components/parameters/XRequestId"
          },
          {
            "$ref": "#/components/parameters/XCorrelationId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CloseTabRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Conta fechada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Bill"
                }
              }
            }
          },
          "409": {
            "$ref": "#/components/responses/IdempotencyConflict"
          },
          "422": {
            "$ref": "#/components/responses/DomainError"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "headers": {
      "XRequestId": {
        "description": "Identificador técnico da requisição",
        "schema": {
          "type": "string"
        }
      },
      "XCorrelationId": {
        "description": "Identificador de correlação ponta a ponta",
        "schema": {
          "type": "string"
        }
      }
    },
    "parameters": {
      "XRequestId": {
        "name": "X-Request-Id",
        "in": "header",
        "required": false,
        "schema": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128
        }
      },
      "XCorrelationId": {
        "name": "X-Correlation-Id",
        "in": "header",
        "required": false,
        "schema": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128
        }
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128
        }
      },
      "XUnitId": {
        "name": "X-Unit-Id",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "TabId": {
        "name": "tabId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "ItemId": {
        "name": "itemId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Credencial ausente, inválida ou expirada",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Forbidden": {
        "description": "Ator sem autorização para o escopo",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "NotFound": {
        "description": "Recurso inexistente ou não visível no escopo autorizado",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "DomainError": {
        "description": "Regra de domínio impediu a operação",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "IdempotencyConflict": {
        "description": "Mesma chave de idempotência com payload divergente",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "examples": {
              "conflict": {
                "value": {
                  "code": "IDEMPOTENCY_PAYLOAD_CONFLICT",
                  "message": "A operação já foi registrada com payload diferente.",
                  "requestId": "req_demo_123",
                  "correlationId": "corr_demo_123"
                }
              }
            }
          }
        }
      }
    },
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "examples": [
              "waiter.demo@mrcoti.local"
            ]
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          }
        }
      },
      "LoginResponse": {
        "type": "object",
        "required": [
          "accessToken",
          "expiresInSeconds",
          "context"
        ],
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "Token local futuro. Exemplo não real."
          },
          "expiresInSeconds": {
            "type": "integer",
            "minimum": 60
          },
          "context": {
            "$ref": "#/components/schemas/CurrentContext"
          }
        }
      },
      "CurrentContext": {
        "type": "object",
        "required": [
          "user",
          "tenant",
          "units",
          "roles",
          "permissions"
        ],
        "properties": {
          "user": {
            "$ref": "#/components/schemas/User"
          },
          "tenant": {
            "$ref": "#/components/schemas/Tenant"
          },
          "units": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Unit"
            }
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "User": {
        "type": "object",
        "required": [
          "id",
          "displayName"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "displayName": {
            "type": "string"
          }
        }
      },
      "Tenant": {
        "type": "object",
        "required": [
          "id",
          "name",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "SUSPENDED"
            ]
          }
        }
      },
      "Unit": {
        "type": "object",
        "required": [
          "id",
          "name",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "INACTIVE"
            ]
          }
        }
      },
      "Category": {
        "type": "object",
        "required": [
          "id",
          "name",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "INACTIVE"
            ]
          }
        }
      },
      "CreateCategoryRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80
          }
        }
      },
      "ProductStatus": {
        "type": "string",
        "enum": [
          "AVAILABLE",
          "UNAVAILABLE",
          "INACTIVE"
        ]
      },
      "Product": {
        "type": "object",
        "required": [
          "id",
          "categoryId",
          "name",
          "priceCents",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "categoryId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "priceCents": {
            "type": "integer",
            "minimum": 0
          },
          "status": {
            "$ref": "#/components/schemas/ProductStatus"
          }
        }
      },
      "CreateProductRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "categoryId",
          "name",
          "priceCents"
        ],
        "properties": {
          "categoryId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          },
          "priceCents": {
            "type": "integer",
            "minimum": 0
          },
