              "DRAFT",
              "PAYMENT_PENDING",
              "PAYMENT_FAILED",
              "PAID",
              "CLOSED"
            ]
          },
          "payment": {
            "$ref": "#/components/schemas/FakePayment"
          }
        }
      },
      "FakePayment": {
        "type": "object",
        "required": [
