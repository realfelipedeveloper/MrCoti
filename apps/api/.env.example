# API — exemplo de ambiente local
#
# Fonte principal: ../../.env.example
# Este arquivo existe apenas para documentar variáveis consumidas pela API.

NODE_ENV=development
API_PORT=3200
DATABASE_URL=mysql://mrcoti_app:<replace-with-local-mysql-password>@mysql:3306/mrcoti
REDIS_ENABLED=false
REDIS_PASSWORD=<replace-with-local-redis-password>
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
JWT_ACCESS_SECRET=<replace-with-local-access-secret-min-32-chars>
JWT_REFRESH_SECRET=<replace-with-local-refresh-secret-min-32-chars>
PASSWORD_PEPPER=<replace-with-local-password-pepper>
LOG_LEVEL=debug
REQUEST_ID_HEADER=x-request-id
CORRELATION_ID_HEADER=x-correlation-id
DEMO_SEED_ENABLED=true
