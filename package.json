{
  "name": "mrcoti",
  "version": "0.0.0",
  "private": true,
  "description": "Mr Coti — MVP dev/local multi-tenant para portfólio técnico.",
  "license": "UNLICENSED",
  "packageManager": "npm@11.11.0",
  "scripts": {
    "contract:check": "node scripts/validate-openapi.mjs",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --check \"package.json\" \"eslint.config.mjs\" \"jest.config.mjs\" \".prettierrc.json\" \"scripts/**/*.mjs\" \"apps/**/*.{json,md,ts,tsx,js,mjs}\" \"packages/**/*.{json,md,ts,tsx,js,mjs}\"",
    "format:write": "prettier --write \"package.json\" \"eslint.config.mjs\" \"jest.config.mjs\" \".prettierrc.json\" \"scripts/**/*.mjs\" \"apps/**/*.{json,md,ts,tsx,js,mjs}\" \"packages/**/*.{json,md,ts,tsx,js,mjs}\"",
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify": "npm run lint && npm run format && npm run typecheck && npm run test && npm run contract:check"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/testing": "^11.1.28",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.1",
    "@types/supertest": "^7.2.0",
    "eslint": "^10.7.0",
    "jest": "^30.4.2",
    "prettier": "^3.9.5",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  }
}
