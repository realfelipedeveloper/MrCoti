# Mr Coti — exemplo de ambiente dev/local
#
# Copie para `.env.local` ou `.env` apenas na sua máquina e substitua todos os
# placeholders `<...>`. Este arquivo não deve conter credenciais funcionais.

# Runtime
NODE_ENV=development
MRCOTI_ENV=dev-local
MRCOTI_PUBLIC_APP_NAME=Mr Coti

# Portas locais configuráveis
WEB_PORT=3400
API_PORT=3200
SWAGGER_PORT=3201
MYSQL_HOST_PORT=3308
REDIS_HOST_PORT=6380
MAILPIT_SMTP_PORT=1026
MAILPIT_WEB_PORT=8026
MINIO_API_PORT=9100
MINIO_CONSOLE_PORT=9101
GRAFANA_PORT=3401
PROMETHEUS_PORT=9091
LOKI_PORT=3402

# URLs locais
WEB_PUBLIC_URL=http://localhost:${WEB_PORT}
API_PUBLIC_URL=http://localhost:${API_PORT}
NEXT_PUBLIC_API_BASE_URL=http://localhost:${API_PORT}/api/v1

# Banco MySQL local via Docker Desktop/local Docker
MYSQL_DATABASE=mrcoti
MYSQL_USER=mrcoti_app
MYSQL_PASSWORD=<replace-with-local-mysql-password>
MYSQL_ROOT_PASSWORD=<replace-with-local-root-password>
DATABASE_URL=mysql://${MYSQL_USER}:${MYSQL_PASSWORD}@mysql:3306/${MYSQL_DATABASE}

# Redis local opcional — só subir quando uma task exigir uso real
REDIS_ENABLED=false
REDIS_PASSWORD=<replace-with-local-redis-password>
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

# Segurança local sintética
JWT_ACCESS_SECRET=<replace-with-local-access-secret-min-32-chars>
JWT_REFRESH_SECRET=<replace-with-local-refresh-secret-min-32-chars>
PASSWORD_PEPPER=<replace-with-local-password-pepper>

# Observabilidade local mínima
LOG_LEVEL=debug
REQUEST_ID_HEADER=x-request-id
CORRELATION_ID_HEADER=x-correlation-id

# Dados demo sintéticos
DEMO_TENANT_SLUG=mrcoti-demo
DEMO_USER_DOMAIN=mrcoti.local
DEMO_SEED_ENABLED=true
